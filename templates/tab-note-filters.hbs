<div class="dxql-filters">
  <nav class="dxql-status-tabs" aria-label="{{localize "DXQL.PartyNote.FilterLabel"}}">
    {{#each statusTabs}}
    <button type="button" class="dxql-status-tab note-filter-{{id}} {{#if active}}active{{/if}}" data-action="setStatusFilter"
            data-status="{{id}}" aria-pressed="{{active}}">
      {{label}} <span class="dxql-count">{{count}}</span>
    </button>
    {{/each}}
  </nav>
  <div class="dxql-toolbar">
    <label class="dxql-groupby">
      <i class="fa-solid fa-layer-group" inert></i>
      <select name="groupBy" aria-label="{{localize "DXQL.PartyNote.GroupByLabel"}}">
        {{selectOptions groupOptions selected=groupBy}}
      </select>
    </label>
    {{#if tagFilter}}
    <button type="button" class="dxql-tag dxql-tag-filter" style="--hue: {{tagHue}}" data-action="clearTag"
            data-tooltip="DXQL.ClearTagFilter">
      <i class="fa-solid fa-tag" inert></i> {{tagFilter}} <i class="fa-solid fa-xmark" inert></i>
    </button>
    {{/if}}
  </div>
</div>
