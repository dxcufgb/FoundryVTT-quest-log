<div class="dxql-list">
  {{#unless ready}}
  <div class="dxql-empty">
    <i class="fa-solid fa-hourglass-half" inert></i>
    <p>{{localize "DXQL.NotReady"}}</p>
  </div>
  {{else}}
  {{#each groups}}
  <section class="dxql-group {{#if collapsed}}collapsed{{/if}}" data-group="{{key}}">
    {{#if label}}
    <button type="button" class="dxql-group-header" data-action="toggleGroup" aria-expanded="{{#if collapsed}}false{{else}}true{{/if}}">
      <i class="dxql-caret fa-solid fa-chevron-down" inert></i>
      <i class="{{icon}} dxql-group-icon" inert></i>
      <span class="dxql-group-label {{#if unknown}}unknown{{/if}}">{{label}}</span>
      <span class="dxql-count">{{count}}</span>
    </button>
    {{/if}}
    <ol class="dxql-quests dxql-rewards">
      {{#each rewards}}
      <li class="dxql-quest dxql-reward reward-{{status}} {{#if hidden}}is-hidden{{/if}}" data-reward-id="{{id}}" data-action="openReward"
          tabindex="0" draggable="false">
        <div class="dxql-reward-icon">
          {{#if img}}<img src="{{img}}" alt="">{{else}}<i class="{{statusIcon}}" inert></i>{{/if}}
        </div>
        <div class="dxql-quest-body">
          <div class="dxql-quest-title">
            <span>{{name}}</span>
            {{#if hidden}}<i class="fa-solid fa-eye-slash dxql-hidden-icon" data-tooltip="DXQL.HiddenFromPlayers"></i>{{/if}}
          </div>
          {{#if (or questTitle links.length)}}
          <div class="dxql-quest-meta">
            {{#if questTitle}}<span><i class="fa-solid fa-scroll" inert></i>{{questTitle}}</span>{{/if}}
            {{#each links}}<span data-tooltip="{{label}}"><i class="{{icon}}" inert></i>{{name}}</span>{{/each}}
          </div>
          {{/if}}
          <div class="dxql-uses-row">
            {{#if (eq status "claimed")}}
            <span class="dxql-uses-label claimed"><i class="fa-solid fa-box-archive" inert></i> {{claimedLabel}}{{#unless unlimited}} · {{usesLabel}}{{/unless}}</span>
            {{else if unlimited}}
            <span class="dxql-uses-label unlimited"><i class="fa-solid fa-infinity" inert></i> {{usesLabel}}</span>
            {{else}}
            {{#if pips}}<span class="dxql-pips" aria-hidden="true">{{#each pips}}<i class="dxql-pip {{#if full}}full{{/if}}"></i>{{/each}}</span>{{/if}}
            <span class="dxql-uses-label">{{usesLabel}}</span>
            {{/if}}
            {{#if canUse}}
            <button type="button" class="dxql-use-btn" data-action="useReward" data-tooltip="DXQL.Reward.UseHint">
              <i class="fa-solid fa-hand-sparkles" inert></i> {{localize "DXQL.Reward.Use"}}</button>
            {{/if}}
          </div>
          {{#if snippet}}<div class="dxql-snippet">{{{snippet}}}</div>{{/if}}
        </div>
      </li>
      {{/each}}
    </ol>
  </section>
  {{else}}
  <div class="dxql-empty">
    <i class="fa-solid fa-gift" inert></i>
    <p>{{emptyMessage}}</p>
    {{#if searching}}
    <button type="button" data-action="clearSearch"><i class="fa-solid fa-xmark" inert></i> {{localize "DXQL.ClearSearch"}}</button>
    {{else}}{{#unless total}}
    <button type="button" data-action="createReward"><i class="fa-solid fa-plus" inert></i> {{localize "DXQL.Reward.New"}}</button>
    {{/unless}}{{/if}}
  </div>
  {{/each}}
  {{/unless}}
</div>
